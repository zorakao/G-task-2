<div id="app" class="page-width page-section page-stack" v-cloak>
  <%- include('../partials/steps', { step: 0 }) %>
  <div class="page-heading"><h1 id="cart-title" tabindex="-1">購物車</h1><p v-if="!loading && !loadError">{{ items.length ? '購物車裡有 ' + items.length + ' 件花禮。' : '挑一束喜歡的花，把心意放進來。' }}</p></div>
  <div v-if="loading"><%- include('../partials/loading') %></div>
  <div v-else-if="loadError" class="error-state" role="alert"><h2>暫時無法載入購物車</h2><p>請確認網路連線後再試一次。</p><button class="button button-secondary" @click="loadCart">重新載入</button></div>
  <div v-else-if="items.length === 0" class="empty-state"><fl-icon name="shopping-bag"></fl-icon><h2>購物車還空著</h2><p>送給在意的人，也送給自己。<br>先挑一束喜歡的花吧。</p><a href="/" class="button">去選花</a></div>
  <template v-else>
    <div class="notice"><fl-icon name="truck"></fl-icon><span>{{ total >= 500 ? '已達免運門檻，這份心意由我們送達。' : '運費已包含於本次訂單，不另收費。' }}</span></div>
    <div class="commerce-grid">
      <div><div class="cart-items"><article v-for="item in items" :key="item.id" class="cart-item"><a :href="'/products/' + item.product_id" :aria-label="'查看' + item.product.name"><img :src="productImage(item.product)" :alt="item.product.name" width="112" height="128" @error="imageFallback"></a><div><h2>{{ item.product.name }}</h2><p class="cart-item-price">{{ money(item.product.price) }}</p></div><div class="cart-item-controls"><div class="quantity-control" role="group" :aria-label="item.product.name + '的數量'"><button @click="updateQuantity(item, item.quantity - 1)" :disabled="item.quantity <= 1 || item._updating" :aria-label="'減少' + item.product.name + '數量'"><fl-icon name="minus"></fl-icon></button><output aria-live="polite">{{ item.quantity }}</output><button @click="updateQuantity(item, item.quantity + 1)" :disabled="item.quantity >= item.product.stock || item._updating" :aria-label="'增加' + item.product.name + '數量'"><fl-icon name="plus"></fl-icon></button></div><p class="cart-subtotal">{{ money(item.product.price * item.quantity) }}</p><button class="icon-button text-muted" :aria-label="'移除' + item.product.name" :disabled="item._updating" @click="confirmDelete(item)"><fl-icon name="trash-2"></fl-icon></button></div></article></div><a class="text-link mt-4" href="/"><fl-icon name="chevron-left"></fl-icon>繼續選花</a></div>
      <aside class="summary" aria-labelledby="cart-summary-title"><h2 id="cart-summary-title">訂單摘要</h2><div class="summary-row"><span>商品小計</span><span>{{ money(total) }}</span></div><div class="summary-row"><span>運費</span><span>免運</span></div><div class="summary-row summary-total"><span>總計</span><span>{{ money(total) }}</span></div><button class="button" @click="goCheckout" :disabled="items.some(item => item._updating)">前往結帳</button><p class="summary-note"><fl-icon name="lock-keyhole"></fl-icon>下一步填寫收件資訊</p><p v-if="!loggedIn" class="form-help">結帳需要登入，登入後請確認會員購物車內容。</p></aside>
    </div>
  </template>
  <dialog ref="removeDialog" class="confirm-dialog" aria-labelledby="remove-title"><h2 id="remove-title">移除這份花禮？</h2><p class="body-copy">「{{ selectedItem?.product.name }}」將從購物車移除。</p><div class="dialog-actions"><button class="button button-secondary" @click="removeDialog.close()" :disabled="deleting">保留花禮</button><button class="button" @click="handleDelete" :disabled="deleting">{{ deleting ? '移除中…' : '確認移除' }}</button></div></dialog>
</div>
