<div id="app" v-cloak>
  <section class="page-width page-section auth-layout" id="member-access">
    <div class="auth-visual"><img src="/images/flowers/hero.png?v=flower-life-2" alt="清晨花桌上的白色與淡紫花禮" width="580" height="430"><div class="auth-visual-copy"><h2>為每一天，留一點美好。</h2><p>記下每一次送花的心意，<br>讓下一次的相遇更簡單。</p></div></div>
    <div class="auth-form"><div class="page-heading"><h1>{{ activeTab === 'login' ? '歡迎回到' : '加入花漾生活。' }}<br v-if="activeTab === 'login'"><template v-if="activeTab === 'login'">花漾生活。</template></h1><p>{{ activeTab === 'login' ? '登入後，繼續你的選花時光。' : '建立帳號，開始你的花漾日常。' }}</p></div>
    <div class="auth-tabs" role="tablist" aria-label="會員入口"><button id="login-tab" role="tab" :aria-selected="activeTab === 'login'" aria-controls="auth-panel" @click="switchTab('login')" @keydown.right.prevent="switchTab('register', true)" @keydown.left.prevent="switchTab('register', true)">登入</button><button id="register-tab" role="tab" :aria-selected="activeTab === 'register'" aria-controls="auth-panel" @click="switchTab('register')" @keydown.right.prevent="switchTab('login', true)" @keydown.left.prevent="switchTab('login', true)">註冊</button></div>
    <div id="auth-panel" role="tabpanel" :aria-labelledby="activeTab + '-tab'">
      <form @submit.prevent="activeTab === 'login' ? handleLogin() : handleRegister()" novalidate>
        <div v-if="authError" class="error-state" role="alert"><p class="!m-0">{{ authError }}</p></div>
        <div v-if="activeTab === 'register'" class="form-field"><label for="member-name">姓名</label><input id="member-name" class="text-input" v-model.trim="registerForm.name" autocomplete="name" placeholder="請輸入姓名" :aria-invalid="!!errors.name" :aria-describedby="errors.name ? 'name-error' : null" required><p v-if="errors.name" id="name-error" class="field-error">{{ errors.name }}</p></div>
        <div class="form-field"><label for="member-email">電子郵件</label><input id="member-email" class="text-input" :value="activeTab === 'login' ? loginForm.email : registerForm.email" @input="setEmail($event.target.value)" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com" :aria-invalid="!!errors.email" :aria-describedby="errors.email ? 'email-error' : null" required><p id="email-error" v-if="errors.email" class="field-error">{{ errors.email }}</p></div>
        <div class="form-field"><label for="member-password">密碼</label><div class="password-input"><input id="member-password" class="text-input" :value="activeTab === 'login' ? loginForm.password : registerForm.password" @input="setPassword($event.target.value)" :type="showPassword ? 'text' : 'password'" :autocomplete="activeTab === 'login' ? 'current-password' : 'new-password'" :placeholder="activeTab === 'login' ? '請輸入密碼' : '至少 6 個字元'" :aria-invalid="!!errors.password" :aria-describedby="errors.password ? 'password-error' : null" required><button type="button" class="icon-button password-visible" @click="showPassword = !showPassword" :aria-label="showPassword ? '隱藏密碼' : '顯示密碼'" :aria-pressed="showPassword">{{ showPassword ? '隱藏' : '顯示' }}</button></div><p id="password-error" v-if="errors.password" class="field-error">{{ errors.password }}</p></div>
        <button type="submit" class="button w-full" :disabled="submitting">{{ submitting ? (activeTab === 'login' ? '登入中…' : '建立中…') : (activeTab === 'login' ? '登入' : '建立帳號') }}</button>
      </form>
    </div><p class="form-help">{{ activeTab === 'login' ? '還沒有帳號？切換至註冊即可開始。' : '已有帳號？切換至登入，接續你的心意。' }}</p></div>
  </section>
  <section class="auth-mobile-brand"><h2>為每一天，留一點美好。</h2><p>記下每一次送花的心意。</p></section>
</div>
