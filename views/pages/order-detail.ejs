<div id="app" class="page-width page-section page-stack" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>" v-cloak>
  <nav class="breadcrumb" aria-label="麵包屑"><a href="/orders">我的訂單</a><span>/</span><span>{{ order ? order.order_no : '訂單詳情' }}</span></nav>
  <div v-if="loading"><%- include('../partials/loading') %></div>
  <div v-else-if="loadError" class="error-state" role="alert"><h1 class="section-heading">{{ notFound ? '找不到這筆訂單' : '暫時無法載入訂單' }}</h1><p>{{ notFound ? '請確認訂單編號，或回到我的訂單查看。' : '請確認網路連線後重新載入。' }}</p><a v-if="notFound" class="button button-secondary" href="/orders">返回我的訂單</a><button v-else class="button button-secondary" @click="loadOrder">重新載入</button></div>
  <template v-else-if="order">
    <div class="order-heading"><div class="page-heading"><h1>訂單詳情</h1><p>訂單編號 {{ order.order_no }}<br>建立日期 {{ date(order.created_at) }}</p></div><span class="status-badge" :class="'status-' + order.status"><fl-icon :name="statusIcon(order.status)"></fl-icon>{{ statusLabel(order.status) }}</span></div>
    <div v-if="paymentNotice" class="payment-alert" :class="'status-' + paymentNotice.status" role="status" aria-live="polite"><span v-if="verifying" class="spinner"></span><fl-icon v-else :name="statusIcon(paymentNotice.status)"></fl-icon><p>{{ paymentNotice.text }}</p></div>
    <div class="commerce-grid order-detail-grid"><div class="order-information"><section><h2 class="section-heading mb-5">收件資訊</h2><div class="recipient-details"><p>{{ order.recipient_name }}</p><p>{{ order.recipient_email }}</p><p>{{ order.recipient_address }}</p></div></section><hr class="divider"><section><h2 class="section-heading mb-3">花禮明細</h2><div v-for="item in order.items" :key="item.id" class="order-item"><div><h3>{{ item.product_name }}</h3><p>{{ money(item.product_price) }} × {{ item.quantity }}</p></div><span>{{ money(item.product_price * item.quantity) }}</span></div></section><a class="text-link" href="/orders"><fl-icon name="chevron-left"></fl-icon>返回我的訂單</a></div>
    <aside class="summary payment-summary"><h2>{{ order.status === 'paid' ? '付款已完成' : order.status === 'failed' ? '付款未完成' : '完成付款' }}</h2><div class="summary-row"><span>商品小計</span><span>{{ money(order.total_amount) }}</span></div><div class="summary-row"><span>運費</span><span>免運</span></div><div class="summary-row summary-total"><span>付款金額</span><span>{{ money(order.total_amount) }}</span></div><button v-if="order.status === 'pending'" class="button" @click="startEcpayCheckout" :disabled="paying || verifying">{{ paying ? '導向中…' : '前往綠界付款' }}</button><button v-if="order.status !== 'paid'" class="button button-secondary" @click="verifyOrderPayment(true)" :disabled="verifying || paying">{{ verifying ? '查詢中…' : '重新查詢付款結果' }}</button><a v-if="order.status === 'paid'" class="button" href="/">繼續選花</a><p class="form-help">{{ order.status === 'paid' ? '已確認付款，謝謝你的心意。' : order.status === 'failed' ? '請重新查詢付款結果，確認最新狀態。' : '已經付款了？請重新查詢付款結果。完成付款後，訂單狀態會更新於此。' }}</p></aside></div>
  </template>
</div>
